<div class="news">
  {% assign sorted_explorations = site.explorations | sort: 'date' | reverse %}
  {% assign explorations_size = sorted_explorations | size %}
  {% if explorations_size > 0 %}
    {% if page.latest_explorations.limit %}
      {% assign explorations_limit = page.latest_explorations.limit %}
    {% else %}
      {% assign explorations_limit = explorations_size %}
    {% endif %}
    <div
      class="table-responsive"
      {% if page.latest_explorations.scrollable and explorations_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in sorted_explorations limit: explorations_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No explorations yet.</p>
  {% endif %}
</div>
